require 'rspec'
require 'rubyzen'
require_relative '../spec_helper'

RSpec.describe 'Actions expose a single public method' do
  context 'given an action' do
    it 'has a single public method called execute' do
      expect(actions.without_name(*baseline)).to be_true { |action|
        public_methods = action.instance_methods.filter do |method|
          #  Ignore initialize method
           method.public? && method.name != "initialize"
        end


        name = public_methods&.first&.name

        public_methods.count == 1 && name == "execute"
      }
    end
  end

